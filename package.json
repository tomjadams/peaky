{
  "name": "orr-sample",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:migrations:embed && nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "typecheck": "nuxt typecheck",
    "validate": "pnpm lint && pnpm typecheck",
    "catalog:import": "node scripts/import-launchpad-catalog.mjs",
    "ldap:users:export": "node scripts/export-ldap-users.mjs",
    "db:migrations:generate": "drizzle-kit generate --config=drizzle.config.ts && pnpm db:migrations:embed",
    "db:migrations:embed": "node scripts/generate-sqlite-migration-content.mjs",
    "gen:db:mysql": "bash services/scripts/schema-drift-gate.sh",
    "gen:schemas": "tsx scripts/generate-drizzle-from-sql.ts",
    "openspec:ids": "tsx scripts/openspec-ids.ts",
    "events:schemas": "tsx scripts/generate-event-schemas.ts",
    "fmt": "oxfmt",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:sync": "PEAKY_E2E_SYNC_STACK=1 playwright test --project=chromium tests/e2e/sync-scoped-pull.spec.ts",
    "test:a11y": "playwright test --project=a11y",
    "gen:sync-types": "openapi-typescript services/sync-api.yaml -o shared/types/sync-api.d.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.108",
    "@iconify-json/simple-icons": "^1.2.82",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@nuxt/icon": "^2.2.2",
    "@nuxt/ui": "^4.7.1",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@sqlite.org/sqlite-wasm": "^3.41.2",
    "@tiptap/extension-character-count": "3.22.5",
    "@tiptap/extension-placeholder": "3.22.5",
    "@tiptap/starter-kit": "3.22.5",
    "@tiptap/vue-3": "3.22.5",
    "@types/better-sqlite3": "^7.6.13",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fuse.js": "^7.3.0",
    "h3": "^1.15.11",
    "jose": "^6.2.3",
    "nuxt": "^4.4.6",
    "nuxt-security": "^2.6.0",
    "sortablejs": "^1.15.7",
    "sqlocal": "^0.17.0",
    "tailwindcss": "^4.3.0",
    "uuid": "^13.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@axe-core/playwright": "^4.11.3",
    "@faker-js/faker": "^9.9.0",
    "@fission-ai/openspec": "1.6.0",
    "@fizzbee/mbt": "^0.1.2",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/vue": "^8.1.0",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^1.65.0",
    "eslint-plugin-security": "^4.0.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "node-gyp": "^12.3.0",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.14.2",
    "rumdl": "^0.1.94",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "pnpm": {
    "overrides": {
      "@vue/reactivity": "3.5.34",
      "@vue/runtime-core": "3.5.34",
      "@vue/runtime-dom": "3.5.34",
      "@vue/shared": "3.5.34",
      "@vueuse/core": "^14.3.0",
      "chokidar": "3.6.0",
      "magic-string": "^0.30.21"
    },
    "patchedDependencies": {
      "@vue/compiler-sfc@3.5.34": "patches/@vue__compiler-sfc@3.5.34.patch"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
