# direnv bootstrap for Peaky maintainers — run `direnv allow` once.
# Each section is guarded so it only does work when needed.

# ── Prerequisites ──────────────────────────────────────────────────
# agent-marketplace provides the RTF harness that most workflows rely on,
# so a missing binary is a hard failure (not a warning).
if ! command -v agent-marketplace >/dev/null 2>&1; then
  log_error "agent-marketplace not on PATH — required for the RTF harness."
  log_error "Opening Managed Software Center to install it: munki://detail-agent-marketplace.html"
  command -v open >/dev/null 2>&1 && open "munki://detail-agent-marketplace.html"
  exit 1
fi

# ── Dev environment ────────────────────────────────────────────────
# `make dev` bootstraps Node, Go tools, docs deps, and Playwright.
# Runs on a fresh checkout; re-run it manually after dependency bumps.
if [ ! -d node_modules ]; then
  log_status "Bootstrapping dev environment (make dev)…"
  make dev || log_error "make dev failed — see output above, then run 'direnv reload'."
fi
PATH_add node_modules/.bin

# ── RTF harness (agent-marketplace) ────────────────────────────────
# Syncs the gitignored .factory/ skills, commands, rules, and droids at
# repo scope, driven by the committed .agents/config.yaml. Needs SSH
# access to gitlab.is.adyen.com.
if ! agent-marketplace status 2>/dev/null | grep -q "containers/rtf/harness"; then
  log_status "Syncing RTF harness via agent-marketplace (scope: repo)…"
  agent-marketplace sync ||
  log_error "agent-marketplace sync failed — check SSH access, then run 'direnv reload'."
fi
