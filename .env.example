# Base URL for the application. Required for Okta single-logout (SLO) —
# logout redirects to Okta's end_session_endpoint and Okta lands the user
# back at `${NUXT_PUBLIC_BASE_URL}/auth/login`. Always HTTPS in production.
NUXT_PUBLIC_BASE_URL=

# OIDC / Okta authentication (server-only).
#
# Required for real Okta login (DOMAIN, CLIENT_ID, PRIVATE_KEY, SESSION_SECRET).
# PRIVATE_KEY is the JWK JSON PE delivers for `private_key_jwt` — jose's
# `importJWK` parses it verbatim. SESSION_SECRET seals the H3 session cookie.
#
# Local dev bypass: set SESSION_SECRET alone and visit /auth/dev/login
# to mint a fake session — only available outside production.
#
# Set NUXT_OIDC_AUTH_DEBUG=1 to enable the round-trip JWT claim dumps
# (server + client logs). Off by default in production.
#
NUXT_OIDC_OKTA_DOMAIN=
NUXT_OIDC_OKTA_CLIENT_ID=
NUXT_OIDC_OKTA_PRIVATE_KEY=
NUXT_OIDC_OKTA_LOGOUT_URL=
NUXT_OIDC_SESSION_SECRET=
NUXT_OIDC_AUTH_DEBUG=
