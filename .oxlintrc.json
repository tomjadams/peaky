{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "vue", "oxc"],
  "jsPlugins": ["./oxlint-plugins/peaky-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "complexity": ["warn", { "max": 20 }],
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "import/no-default-export": "off",
    "unicorn/no-null": "off",
    "unicorn/no-empty-file": "off",
    "no-case-declarations": "off",
    "no-await-in-loop": "off",
    "import/no-named-as-default": "off",

    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/consistent-type-imports": "error",

    "max-params": ["warn", { "max": 4 }],
    "max-depth": ["warn", { "max": 3 }],
    "max-lines": ["warn", { "max": 400, "skipBlankLines": true, "skipComments": true }],

    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-number-properties": "error",
    "oxc/no-accumulating-spread": "error",

    "no-sequences": "error",
    "peaky/enforce-local-mutation-uow": "error",
    "peaky/no-direct-team-review-create": "error",
    "peaky/no-fallible-remote-local-promise-all": "error",
    "eslint/no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    "node_modules/**",
    ".factory/**",
    "dist/**",
    "site/docs/javascripts/**",
    "public/sqlite3*",
    "server/data/template-details-1.ts",
    "formal_verification/mbt/**/*_interfaces.ts",
    "formal_verification/mbt/**/*_test.ts"
  ],
  "overrides": [
    {
      "files": ["app/services/review/TeamReviewService.ts"],
      "rules": {
        "peaky/no-direct-team-review-create": "off"
      }
    },
    {
      "files": ["app/services/local-mutation.ts"],
      "rules": {
        "peaky/enforce-local-mutation-uow": "off"
      }
    },
    {
      "files": [
        "app/services/entity/ProductMutations.ts",
        "app/composables/local/useLocalTemplatePillars.ts",
        "app/composables/local/useLocalTemplateQuestions.ts"
      ],
      "rules": {
        "peaky/enforce-local-mutation-uow": [
          "error",
          { "allowedBypassCount": 0 }
        ]
      }
    },
    {
      "files": ["app/composables/local/useLocalTemplateDraft.ts"],
      "rules": {
        "peaky/enforce-local-mutation-uow": [
          "error",
          { "allowedBypassCount": 0 }
        ]
      }
    },
    {
      "files": ["app/composables/local/useLocalTemplateImport.ts"],
      "rules": {
        "peaky/enforce-local-mutation-uow": [
          "error",
          { "allowedBypassCount": 0 }
        ]
      }
    },
    {
      "files": [
        "app/services/entity/ReviewMutations.ts",
        "app/composables/templates/storage/useTemplatePersistence.ts"
      ],
      "rules": {
        "peaky/enforce-local-mutation-uow": [
          "error",
          { "allowedBypassCount": 0 }
        ]
      }
    },
    {
      "files": ["**/*.vue"],
      "rules": {
        "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
        "max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["tests/**/*", "**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/unbound-method": "off",
        "max-lines": ["warn", { "max": 500, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["tests/e2e/**/*.spec.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["tests/nuxt/**/*"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["tests/unit/**/*", "tests/nuxt/**/*"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "regex": ".*server/db.*",
              "message": "No real DB in unit/nuxt tests — move to tests/integration/"
            }
          ]
        }]
      }
    },
    {
      "files": ["tests/unit/ui/**/*"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            {
              "name": "@testing-library/vue",
              "message": "Move to tests/nuxt/ to run under the Nuxt test environment"
            }
          ]
        }]
      }
    }
  ]
}
