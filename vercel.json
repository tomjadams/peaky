{
  "framework": "nuxtjs",
  "installCommand": "npm_config_registry=https://registry.npmjs.org pnpm install --frozen-lockfile",
  "buildCommand": "export UV_INDEX_URL=https://pypi.org/simple UV_LINK_MODE=copy && cd site && uv lock && uv sync && uv run --no-sync zensical build && cd .. && cp -r site/site public/docs && pnpm run build && node scripts/copy-opfs-proxy.mjs",
  "redirects": [
    {
      "source": "/docs/((?:[^/]+/)*)([^/.]+)",
      "destination": "/docs/$1$2/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_nuxt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
